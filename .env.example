# Copy to .env locally, then replace placeholders. Never commit .env.
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
APP_URL=<YOUR_APP_URL>

# Redis: rediss:// enables TLS automatically.
REDIS_URL=rediss://default:<ROTATED_UPSTASH_TOKEN>@<UPSTASH_HOST>:6379
REDIS_TLS=true
# Use only for isolated, single-process demos without Redis:
# LOCK_MODE=IN_MEMORY_SIMULATION

# Optional PostgreSQL monitoring connection.
DATABASE_URL=<POSTGRES_CONNECTION_STRING>
